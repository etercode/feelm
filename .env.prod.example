# Template for the server's .env.prod, which is not in the repository.
# Copy to .env.prod on the host and fill in real values.
#
# Read twice: by Compose for ${...} interpolation (the POSTGRES_* lines), and
# by Symfony inside the container (everything else).

APP_ENV=prod
APP_DEBUG=0
# php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=

# Must match DATABASE_URL below. The host is the Compose service name.
POSTGRES_DB=feelm
POSTGRES_USER=feelm
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://feelm:CHANGE_ME@database:5432/feelm?serverVersion=18&charset=utf8"

# Where the API is reachable from a browser. /media/... URLs are built on this.
PUBLIC_BASE_URL=https://feelm.org
DEFAULT_URI=https://feelm.org

# The frontend is served from the same origin, so no cross-origin call is made
# in normal use. Listed for anything hitting the API from elsewhere.
CORS_ALLOWED_ORIGINS=https://feelm.org,https://www.feelm.org

# https://www.themoviedb.org/settings/api — the read access token is preferred.
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Requests per ten seconds for the crawler. 300 is 30/sec.
TMDB_REQUESTS_PER_10S=300
